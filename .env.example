# ==================== NextAuth.js 配置 ====================
# Frontend .env.local Configuration

# 应用 URL（部署域名）
# REQUIRED: 必须配置此项，NextAuth需要知道应用运行的UI地址
NEXTAUTH_URL=https://www.qcnote.com

# NextAuth Secret - 用于加密会话令牌
# REQUIRED: 在生产环境必须设置此项，使用强随机密钥
# 生成方法: openssl rand -base64 32
# SECURITY WARNING: 生产环境下不要使用默认值
NEXTAUTH_SECRET=your-secret-key-change-in-production

# 后端API URL（如使用独立后端）
# OPTIONAL: 如果有独立的后端服务器，填写其URL地址
BACKEND_URL=https://your-render-app.onrender.com

# 设备会话令牌签名密钥
# OPTIONAL（但强烈建议单独设置）：未设置时回退到 NEXTAUTH_SECRET，再回退到硬编码默认值
# 生成方法: openssl rand -base64 32
DEVICE_SESSION_SECRET=your-device-session-secret-change-in-production

# 本地数据库加密主密钥（Vault Master Key）
# REQUIRED IN PRODUCTION：用于在服务端加密存储每个用户的本地加密密钥（KEK）。
# 生产环境未设置时 /api/vault/key 会直接拒绝服务，不会静默回退到默认值——
# 这把密钥一旦泄露或使用默认值，等同于让数据库 dump 直接可解密所有用户的 KEK。
# 生成方法（必须是能 base64 解码出 32 字节的值）: openssl rand -base64 32
VAULT_MASTER_KEY=

# 数据库配置
# REQUIRED（生产环境）：PostgreSQL数据库连接字符串（用于存储用户数据）。
# 仅 NODE_ENV=development 且未设置时才会回退到内存 mock 客户端；
# 其他环境下未设置会直接抛错，后端服务无法启动。
DATABASE_URL=postgresql://username:password@localhost:5432/qcnote_db

# Redis 缓存配置
# REQUIRED（生产环境）：Redis连接URL（用于会话存储和缓存）。
# 同 DATABASE_URL，仅开发环境未设置时才会回退到 mock 客户端。
REDIS_URL=redis://localhost:6379
# 备用写法：REDIS_URL 未设置时的回退变量名，二选一即可
# REDIS_CONNECTION_STRING=redis://localhost:6379

# OAuth 提供商 - Google
# OPTIONAL: 配置Google登录功能
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth 提供商 - GitHub
# OPTIONAL: 配置GitHub登录功能
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth 提供商 - Discord
# OPTIONAL: 配置Discord登录功能
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# 应用环境
# development: 开发环境，启用详细日志
# production: 生产环境，优化性能和安全性
NODE_ENV=development

# 日志级别 (OPTIONAL)
# LOG_LEVEL=info

# API 速率限制 (OPTIONAL)
# API_RATE_LIMIT=100

# ==================== 后端环境变量 ====================
# 如果运行独立的Fastify后端服务器，需要配置:

PORT=10000
# OPTIONAL：PORT 未设置时的备用端口变量名（部分平台约定用这个名字）
# REDIRECT_PORT=10000
# OPTIONAL：后端监听地址，默认 0.0.0.0
# HOST=0.0.0.0
FRONTEND_URL=https://www.qcnote.com

# Web Push 推送通知（VAPID）
# OPTIONAL：两者都不设置时推送功能自动禁用（不影响其他功能）；
# 只设置其中一个也视为未配置。生成方法: npx web-push generate-vapid-keys
# VAPID_PUBLIC=
# VAPID_PRIVATE=

# 管理员账号引导脚本（仅安装/部署时的一次性脚本使用，不影响正常运行）
# OPTIONAL：设置后 postinstall 会自动把该邮箱对应账号提升为管理员
# ADMIN_SET_EMAIL=
# OPTIONAL：设置后 postinstall 会检查该邮箱对应账号当前的角色
# ADMIN_CHECK_EMAIL=
# 注意：ADMIN_SET_EMAIL 这个变量名在 push-service 里还被复用作为
# VAPID 推送必须携带的联系邮箱兜底值，和上面的管理员引导用途无关，
# 是历史遗留的命名冲突，未来考虑拆成两个独立变量名。

# 远程日志转发
# OPTIONAL：设置后日志会额外 POST 到这个地址；不设置只打印到 console
# LOG_ENDPOINT=

# ==================== 如何获取 OAuth 密钥 ====================

## Google OAuth
# 1. 访问 https://console.cloud.google.com/
# 2. 创建新项目，启用 Google+ API
# 3. 配置 OAuth 同意屏幕
# 4. 创建 OAuth 2.0 凭证 (Web 应用类型)
# 5. 添加授权的重定向 URI: 
#    - 开发: http://localhost:3000/api/auth/callback/google
#    - 生产: https://www.qcnote.com/api/auth/callback/google
# 6. 复制 Client ID 和 Client Secret

## GitHub OAuth
# 1. 访问 https://github.com/settings/developers/new
# 2. 创建新 OAuth 应用
# 3. 填写回调 URL: https://www.qcnote.com/api/auth/callback/github
# 4. 生成 Personal Access Token，复制 Client ID 和 Client Secret

## Discord OAuth
# 1. 访问 https://discord.com/developers/applications
# 2. 创建新应用，进入OAuth2标签页
# 3. 设置重定向URL: https://www.qcnote.com/api/auth/callback/discord
# 4. 复制 Client ID 和 Client Secret

# ==================== 本地开发启动 ====================
# 1. 复制此文件为 .env.local
# 2. 填入至少必要的变量（NEXTAUTH_URL 和 NEXTAUTH_SECRET）
# 3. 运行: npm install && npm run dev
# 4. 访问: http://localhost:3000

# ==================== 生产环境部署 ====================
# 1. 设置所有必需的环境变量
# 2. 确保 NEXTAUTH_SECRET 是强随机密钥
# 3. 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. 在部署平台（Vercel、Render等）配置这些变量
# 5. 部署并测试OAuth流程
# 2. 创建新应用
# 3. 创建 OAuth2 凭证
# 4. 添加重定向 URL: https://www.qcnote.com/api/auth/callback/discord

# ==================== NEXTAUTH_SECRET 生成 ====================
# 在终端运行：
# openssl rand -base64 32
