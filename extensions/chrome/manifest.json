{
  "manifest_version": 3,
  "name": "QCNOTE Web Clipper",
  "version": "1.1.0",
  "description": "从网页快速剪藏内容到 QCNOTE 应用",
  "permissions": ["activeTab", "storage", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QCNOTE 网页剪藏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
