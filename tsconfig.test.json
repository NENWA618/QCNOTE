{
  // 测试目录的类型检查（根 tsconfig 排除了 test/）。只做检查，不参与构建
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    // 后端依赖装在 server/node_modules，从 test/ 解析不到
    "paths": {
      "pg": ["./server/node_modules/@types/pg"],
      "redis": ["./server/node_modules/redis"]
    }
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "server/fastify.d.ts",
    "test/**/*.ts",
    "test/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
